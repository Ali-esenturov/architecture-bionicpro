{
  "sslRequired": "NONE",
  "id": "reports-realm-id",
  "realm": "reports-realm",
  "enabled": true,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "otpPolicyCodeReusable": true,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Regular user role"
      },
      {
        "name": "administrator",
        "description": "Administrator role"
      },
      {
        "name": "prothetic_user",
        "description": "Prothetic user role with report access"
      }
    ]
  },
  "users": [],
  "clients": [
    {
      "clientId": "reports-frontend",
      "enabled": true,
      "publicClient": true,
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins",
        "broker-read-token"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ],
      "protocolMappers": [
        {
          "name": "broker client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "client.id": "broker"
          }
        }
      ],
      "redirectUris": [
        "https://localhost:3000/*",
        "https://localhost:8443/*"
      ],
      "webOrigins": [
        "https://localhost:3000",
        "https://localhost:8443"
      ],
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "reports-api",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "oNwoLQdvJAvRcL89SydqCWCe5ry1jMgq", 
      "bearerOnly": true
    }
  ],
  "clientScopes": [
    {
      "name": "broker-read-token",
      "description": "Include broker client roles in access token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "broker client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "client.id": "broker"
          }
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "id": "ldap-provider-id",
        "name": "ldap",
        "providerId": "ldap",
        "subType": "ldap",
        "config": {
          "enabled": ["true"],
          "priority": ["0"],
          "vendor": ["other"],
          "connectionUrl": ["ldap://ldap:389"],
          "bindDn": ["cn=admin,dc=example,dc=com"],
          "bindCredential": ["admin"],
          "usersDn": ["ou=People,dc=example,dc=com"],
          "searchScope": ["1"],
          "userSearchAttribute": ["uid"],
          "usernameLDAPAttribute": ["uid"],
          "rdnLDAPAttribute": ["uid"],
          "uuidLDAPAttribute": ["entryUUID"],
          "userObjectClasses": ["inetOrgPerson"],
          "editMode": ["READ_ONLY"],
          "pagination": ["true"],
          "importEnabled": ["true"]
        },
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "id": "ldap-groups-mapper-id",
              "name": "groups",
              "providerId": "group-ldap-mapper",
              "config": {
                "groups.dn": ["ou=Groups,dc=example,dc=com"],
                "group.name.ldap.attribute": ["cn"],
                "group.object.classes": ["groupOfNames"],
                "membership.ldap.attribute": ["member"],
                "membership.attribute.type": ["DN"],
                "preserve.group.inheritance": ["true"],
                "mode": ["READ_ONLY"]
              }
            },
            {
              "id": "ldap-roles-mapper-id",
              "name": "roles",
              "providerId": "role-ldap-mapper",
              "config": {
                "roles.dn": ["ou=Groups,dc=example,dc=com"],
                "role.name.ldap.attribute": ["cn"],
                "role.object.classes": ["groupOfNames"],
                "membership.ldap.attribute": ["member"],
                "membership.attribute.type": ["DN"],
                "use.realm.roles.mapping": ["true"],
                "mode": ["READ_ONLY"]
              }
            },
            {
              "id": "ldap-email-mapper-id",
              "name": "email",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["mail"],
                "user.model.attribute": ["email"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"],
                "is.mandatory.in.ldap": ["false"]
              }
            },
            {
              "id": "ldap-firstname-mapper-id",
              "name": "first name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["cn"],
                "user.model.attribute": ["firstName"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"],
                "is.mandatory.in.ldap": ["false"]
              }
            },
            {
              "id": "ldap-lastname-mapper-id",
              "name": "last name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["sn"],
                "user.model.attribute": ["lastName"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"],
                "is.mandatory.in.ldap": ["false"]
              }
            },
            {
              "id": "ldap-username-mapper-id",
              "name": "username",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["uid"],
                "user.model.attribute": ["username"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"],
                "is.mandatory.in.ldap": ["true"]
              }
            }
          ]
        }
      }
    ]
  },
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10,
      "config": {}
    }
  ],
  "identityProviders": [
    {
      "alias": "yandex",
      "displayName": "Yandex ID",
      "providerId": "oauth2",
      "enabled": true,
      "storeToken": true,
      "trustEmail": false,
      "addReadTokenRoleOnCreate": true,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "authorizationUrl": "https://oauth.yandex.com/authorize?force_confirm=1",
        "tokenUrl": "https://oauth.yandex.com/token",
        "clientId": "e71c5d3e23cf4c3fb6b7aca4b0179fe6",
        "clientSecret": "***",
        "defaultScope": "login:info login:email",
        "storedTokensReadable": "true",
        "identityScript": "/**\n * Available variables:\n * realm - current realm\n * session - KeycloakSession\n * accessToken - OAuth2 access token from Yandex\n */\nvar SimpleHttp = Java.type('org.keycloak.broker.provider.util.SimpleHttp');\nvar BrokeredUserProfile = Java.type('io.phasetwo.keycloak.oauth2idp.model.BrokeredUserProfile');\n\nvar response = SimpleHttp.doGet(\"https://login.yandex.ru/info?format=json\", session)\n  .header(\"Authorization\", \"OAuth \" + accessToken)\n  .asString();\n\nvar identity = JSON.parse(response);\n\nvar profile = new BrokeredUserProfile();\nprofile.setUsername(identity.login || identity.id || identity.default_email);\nprofile.setEmail(identity.default_email || identity.email || \"\");\nprofile.setFirstName(identity.first_name || \"\");\nprofile.setLastName(identity.last_name || \"\");\nprofile.setMappingContext(identity);\n\nprofile;\n"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "yandex-login-to-username",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "login",
        "user.attribute": "username"
      }
    },
    {
      "name": "yandex-email",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "default_email",
        "user.attribute": "email"
      }
    },
    {
      "name": "yandex-first-name",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "first_name",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "yandex-last-name",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "last_name",
        "user.attribute": "lastName"
      }
    }
  ]
}
